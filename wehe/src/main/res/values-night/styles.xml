    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- API 14 theme customizations can go here. -->
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorHighlight">@color/wehe_grey</item>
        <item name="android:textColorSecondary">@color/wehe_grey</item>

        <item name="colorPrimary">@color/black</item> <!-- Toolbar background color -->
        <item name="background">@color/black</item>
        <item name="colorPrimaryDark">@color/wehe_blue</item> <!-- Status bar color -->
        <item name="colorAccent">@color/wehe_blue</item>
    </style>

    <style name="AppTheme.Base" parent="Theme.AppCompat.Light.NoActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
